generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EXECUTIVE
  OPERATIONS_MANAGER
  BRANCH_MANAGER
  SUPERVISOR
  STAFF
  KITCHEN_STAFF
  AUDITOR
  DEVELOPER
  CALL_CENTER
  WAREHOUSE_STAFF
  COMMISSARY_STAFF
  WAITER
  PROCUREMENT
  SALES
  ACCOUNTS
  GENERIC
}

enum DiningTableStatus {
  AVAILABLE
  SEATED
  ORDERING
  BILL_REQUESTED
  DIRTY
  BLOCKED
}

enum TableSessionStatus {
  OPEN
  CLOSED
  VOID
}

enum StaffJobRoleCategory {
  MANAGEMENT
  KITCHEN
  FRONT_OF_HOUSE
  OPERATIONS
  CORPORATE
}

enum ShiftTemplate {
  MORNING
  EVENING
  FULL
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
  ON_LEAVE
  SICK
}

enum DayPart {
  BREAKFAST
  LUNCH
  DINNER
  LATE_NIGHT
}

enum SalesChannel {
  DINE_IN
  TAKEOUT
  DELIVERY
  APP
}

enum AlertType {
  SALES_DROP
  WASTE_SPIKE
  LOW_STOCK
  OVERSTOCK
  STAFF_SHORTAGE
  EXCEPTIONAL_GROWTH
  UNDERPERFORMING_BRANCH
  TARGET_MISSED
  TARGET_ACHIEVED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ADJUSTMENT
  TRANSFER
  VOID
}

enum StockMovementType {
  INBOUND
  OUTBOUND_SALE
  OUTBOUND_WASTE
  OUTBOUND_TRANSFER
  ADJUSTMENT_DAMAGE
  ADJUSTMENT_LOSS
  ADJUSTMENT_CORRECTION
}

enum UnitType {
  KG
  GRAM
  MG
  TON
  LITER
  ML
  CL
  GALLON
  PIECE
  UNIT
  ITEM
  BOX
  CARTON
  CASE
  PACK
  BAG
  SACK
  CRATE
  TRAY
  BOTTLE
  CAN
  JAR
  CUP
  TABLESPOON
  TEASPOON
  SLICE
  PORTION
  SERVING
  PLATE
  DOZEN
  HALF_DOZEN
  BUNCH
  BLOCK
}

enum TransferStatus {
  PENDING
  AWAITING_WAREHOUSE_APPROVAL
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum WarehouseType {
  RAW
  COMMISSARY
}

enum InventoryItemStage {
  RAW
  PROCESSED
  BRANCH_READY
}

enum ProductionBatchStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WarehouseTransferKind {
  MATERIAL_ISSUE
  GENERAL
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  APP
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrderSource {
  CALL_CENTER
  ONLINE
  WHATSAPP
  WALK_IN
  POS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum CustomerVibe {
  VIP
  SPECIAL
  FLAGGED
  LARGE_ORDER
  FOB
}

enum SupplierLeadTime {
  SAME_DAY
  NEXT_DAY
  THREE_TO_SEVEN_DAYS
  THIRTY_DAYS
}

enum SupplierConsistency {
  HIGHLY_RELIABLE
  HIT_OR_MISS
  BACKUP_ONLY
}

enum SupplierCoreCategory {
  PERISHABLES
  DRY_GOODS
  BEVERAGES
  PACKAGING
  CLEANING_SUPPLIES
}

enum SupplierPaymentMethod {
  MOMO_PREFERRED
  BANK_TRANSFER
  CASH_ONLY
}

enum SupplierQualityRating {
  GRADE_A
  STANDARD
  BARGAIN_GRADE
}

enum DeliveryIssue {
  SPILLAGE
  MECHANICAL
  DROP_OFF_ADDRESS
  EXCESSIVE_DELAY
  INACCURATE_ORDER
  PROFESSIONALISM
}

enum PosOfflineMutationStatus {
  PENDING
  ORDER_CREATED
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_DISPATCHED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
}

// ============================================
// AUTH MODELS (BetterAuth)
// ============================================

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  phoneNumber    String?
  pinHash        String?
  role           Role      @default(BRANCH_MANAGER)
  branchId            String?
  assignedWarehouseId String?
  organizationId      String?
  isActive            Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  branch             Branch?            @relation(fields: [branchId], references: [id])
  assignedWarehouse  Warehouse?         @relation("UserAssignedWarehouse", fields: [assignedWarehouseId], references: [id])
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  sessions           Session[]
  accounts           Account[]
  auditLogs          AuditLog[]         @relation("AuditUser")
  posOrders          PosOrder[]
  manualEntryBatches ManualEntryBatch[]
  chatSessions       ChatSession[]
  assignedOrders     Order[]            @relation("AssignedOrders")
  cashierOrders      Order[]            @relation("CashierOrders")
  tableSessionsOpened TableSession[]    @relation("TableSessionsOpened")

  @@index([email])
  @@index([role])
  @@index([branchId])
  @@index([assignedWarehouseId])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================
// CORE BUSINESS MODELS
// ============================================

model Branch {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  address        String
  city           String
  state          String?
  country        String    @default("GH")
  currency       String    @default("GHS")
  phone          String?
  email          String?
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  timezone       String    @default("Africa/Accra")
  isActive            Boolean   @default(true)
  onlineStoreVisible  Boolean   @default(false)
  openingDate    DateTime?
  requiredStaff  Int       @default(5)
  seatCount      Int?
  taxRate        Decimal   @default(12.5) @db.Decimal(5, 2)
  taxName        String    @default("VAT")
  taxEnabled     Boolean   @default(true)
  taxInclusive      Boolean   @default(false)
  showTaxOnReceipt  Boolean   @default(true)
  blockSalesWhenOutOfStock Boolean?
  tableServiceEnabled   Boolean   @default(false)
  paystackSubaccountCode     String?
  paystackSubaccountId       Int?
  settlementBankCode         String?
  settlementAccountNumber    String?
  settlementAccountName      String?
  paystackPercentageCharge   Decimal?  @default(0) @db.Decimal(5, 2)
  paystackSubaccountActive   Boolean?
  paystackSubaccountSyncedAt DateTime?
  paystackSubaccountSource   String?
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  users              User[]
  staff              Staff[]
  sales              Sale[]
  transactions       Transaction[]
  inventoryItems     InventoryItem[]
  inboundStock       InboundStock[]
  outboundStock      OutboundStock[]
  transfersFrom      TransferLog[]      @relation("TransferFrom")
  transfersTo        TransferLog[]      @relation("TransferTo")
  wasteLogs          WasteLog[]
  targets            Target[]
  alerts             Alert[]
  staffSchedules     StaffSchedule[]
  posOrders          PosOrder[]
  posTerminals       PosTerminal[]
  operatingExpenses  OperatingExpense[]
  inventoryStockCounts InventoryStockCount[]
  stockReconciliationSessions StockReconciliationSession[]
  kitchenStations    KitchenStation[]
  manualEntryBatches ManualEntryBatch[]
  apiKeys            ApiKey[]
  taxConfigs         TaxConfig[]
  orders             Order[]
  warehouseTransfers     WarehouseBranchTransfer[] @relation("WarehouseTransfers")
  branchWarehouseReturns BranchWarehouseTransfer[] @relation("BranchWarehouseReturns")
  diningSections           DiningSection[]
  diningTables             DiningTable[]
  tableSessions            TableSession[]
  menuItemBranchVisibility MenuItemBranch[]

  @@index([code])
  @@index([isActive])
  @@index([organizationId])
  @@map("branch")
}

model TaxConfig {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  appliesTo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([isActive])
  @@map("tax_config")
}

model StaffJobRole {
  id                   String               @id @default(cuid())
  organizationId       String
  name                 String
  code                 String
  category             StaffJobRoleCategory?
  description          String?
  sortOrder            Int                  @default(0)
  isActive             Boolean              @default(true)
  defaultShiftTemplate ShiftTemplate?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  staff        Staff[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, sortOrder])
  @@map("staff_job_role")
}

model Staff {
  id         String     @id @default(cuid())
  employeeId String     @unique
  firstName  String
  lastName   String
  email      String?
  phone      String?
  jobRoleId  String
  hourlyRate Decimal    @db.Decimal(10, 2)
  hireDate   DateTime
  branchId   String
  isActive   Boolean    @default(true)
  dutyStatus DutyStatus @default(OFF_DUTY)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  // Relations
  branch       Branch          @relation(fields: [branchId], references: [id])
  jobRole      StaffJobRole    @relation(fields: [jobRoleId], references: [id])
  schedules    StaffSchedule[]
  transactions Transaction[]

  @@index([branchId])
  @@index([jobRoleId])
  @@index([dutyStatus])
  @@map("staff")
}

model StaffSchedule {
  id            String     @id @default(cuid())
  staffId       String
  branchId      String
  scheduledDate DateTime   @db.Date
  shiftStart    DateTime
  shiftEnd      DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  status        DutyStatus @default(OFF_DUTY)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  staff  Staff  @relation(fields: [staffId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([staffId])
  @@index([branchId])
  @@index([scheduledDate])
  @@map("staff_schedule")
}

// ============================================
// SALES & TRANSACTIONS
// ============================================

model MenuItem {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  categoryId  String?
  price       Decimal   @db.Decimal(10, 2)
  cost        Decimal?  @db.Decimal(10, 2)
  isActive               Boolean   @default(true)
  availableAtAllBranches Boolean   @default(true)
  description            String?
  imageUrl               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  // Relations
  category           Category?              @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  posItems           PosOrderItem[]
  ingredients        MenuItemIngredient[]
  manualLines        ManualEntryLine[]
  orderItems         OrderItem[]
  optionGroups       MenuItemOptionGroup[]
  branchAvailability MenuItemBranch[]

  @@index([categoryId])
  @@index([isActive])
  @@index([availableAtAllBranches])
  @@map("menu_item")
}

model MenuItemBranch {
  id         String   @id @default(cuid())
  menuItemId String
  branchId   String
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, branchId])
  @@index([branchId])
  @@map("menu_item_branch")
}

model MenuItemOptionGroup {
  id             String   @id @default(cuid())
  menuItemId     String
  name           String
  sortOrder      Int      @default(0)
  isRequired     Boolean  @default(true)
  minSelections  Int      @default(1)
  maxSelections  Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuItemOption[]

  @@index([menuItemId])
  @@map("menu_item_option_group")
}

model MenuItemOption {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  sortOrder  Int      @default(0)
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  costDelta  Decimal? @db.Decimal(10, 2)
  sku        String?  @unique
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group             MenuItemOptionGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredients       MenuItemOptionIngredient[]
  orderSelections   OrderItemSelection[]
  saleSelections    SaleItemSelection[]

  @@index([groupId])
  @@map("menu_item_option")
}

model MenuItemOptionIngredient {
  id               String   @id @default(cuid())
  menuItemOptionId String
  inventoryItemId  String
  quantity         Decimal  @db.Decimal(12, 3)
  unit             UnitType

  menuItemOption MenuItemOption @relation(fields: [menuItemOptionId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([menuItemOptionId])
  @@index([inventoryItemId])
  @@map("menu_item_option_ingredient")
}

model Sale {
  id            String       @id @default(cuid())
  saleNumber    String       @unique
  branchId      String
  transactionId String?      @unique
  subtotal      Decimal      @db.Decimal(12, 2)
  tax           Decimal      @default(0) @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  dayPart       DayPart
  channel       SalesChannel
  customerCount Int          @default(1)
  saleDate      DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  // Relations
  branch      Branch       @relation(fields: [branchId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  items       SaleItem[]

  @@index([branchId])
  @@index([saleDate])
  @@index([dayPart])
  @@index([channel])
  @@index([branchId, saleDate])
  @@map("sale")
}

model SaleItem {
  id                   String  @id @default(cuid())
  saleId               String
  menuItemId           String
  quantity             Int
  unitPrice            Decimal @db.Decimal(10, 2)
  unitCost             Decimal @db.Decimal(10, 2)
  total                Decimal @db.Decimal(12, 2)
  discount             Decimal @default(0) @db.Decimal(10, 2)
  configurationLabel   String?
  configurationKey     String?

  // Relations
  sale        Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItem    MenuItem             @relation(fields: [menuItemId], references: [id])
  selections  SaleItemSelection[]

  @@index([saleId])
  @@index([menuItemId])
  @@index([configurationKey])
  @@map("sale_item")
}

model SaleItemSelection {
  id               String @id @default(cuid())
  saleItemId       String
  menuItemOptionId String

  saleItem       SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  menuItemOption MenuItemOption @relation(fields: [menuItemOptionId], references: [id])

  @@unique([saleItemId, menuItemOptionId])
  @@index([saleItemId])
  @@index([menuItemOptionId])
  @@map("sale_item_selection")
}

model Transaction {
  id              String   @id @default(cuid())
  transactionRef  String   @unique
  branchId        String
  staffId         String?
  terminalId      String?
  paymentMethod   String
  amount          Decimal  @db.Decimal(12, 2)
  tip             Decimal  @default(0) @db.Decimal(10, 2)
  isVoided        Boolean  @default(false)
  voidReason      String?
  transactionDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  branch   Branch       @relation(fields: [branchId], references: [id])
  staff    Staff?       @relation(fields: [staffId], references: [id])
  terminal PosTerminal? @relation(fields: [terminalId], references: [id])
  sale     Sale?

  @@index([branchId])
  @@index([terminalId])
  @@index([transactionDate])
  @@index([branchId, transactionDate])
  @@map("transaction")
}

model PosTerminal {
  id        String   @id @default(cuid())
  branchId  String
  code      String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  transactions Transaction[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("pos_terminal")
}

model OperatingExpense {
  id          String   @id @default(cuid())
  branchId    String
  amount      Decimal  @db.Decimal(12, 2)
  category    String?
  periodStart DateTime
  periodEnd   DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([periodStart, periodEnd])
  @@map("operating_expense")
}

model InventoryStockCount {
  id           String   @id @default(cuid())
  branchId     String
  itemId       String
  sessionId    String?
  expectedQty  Decimal  @db.Decimal(12, 3)
  actualQty    Decimal  @db.Decimal(12, 3)
  wasteReason  String?
  countedAt    DateTime
  recordedBy   String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch  Branch                      @relation(fields: [branchId], references: [id])
  item    InventoryItem               @relation(fields: [itemId], references: [id])
  session StockReconciliationSession? @relation(fields: [sessionId], references: [id])

  @@index([branchId])
  @@index([itemId])
  @@index([sessionId])
  @@index([countedAt])
  @@index([branchId, countedAt])
  @@map("inventory_stock_count")
}

model StockReconciliationSession {
  id                 String   @id @default(cuid())
  branchId           String
  reconciliationDate DateTime @db.Date
  status             String   @default("SUBMITTED")
  itemCount          Int
  totalShortageQty   Decimal  @db.Decimal(12, 3)
  totalOverageQty    Decimal  @db.Decimal(12, 3)
  totalVarianceCost  Decimal  @db.Decimal(12, 2)
  salesTotalSnapshot Decimal? @db.Decimal(12, 2)
  submittedBy        String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch      Branch                @relation(fields: [branchId], references: [id])
  stockCounts InventoryStockCount[]

  @@unique([branchId, reconciliationDate, status])
  @@index([branchId])
  @@index([reconciliationDate])
  @@index([branchId, reconciliationDate])
  @@map("stock_reconciliation_session")
}

// ============================================
// MENU CATEGORIES
// ============================================

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  menuItems MenuItem[]

  @@index([name])
  @@map("category")
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model Supplier {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  leadTime    SupplierLeadTime?
  consistency SupplierConsistency?
  coreCategory SupplierCoreCategory?
  specialization String?
  paymentMethod SupplierPaymentMethod?
  qualityRating SupplierQualityRating?
  specialNotes String?
  tags        String[]        @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  inboundStock     InboundStock[]
  warehouseInbound WarehouseInbound[]

  @@index([code])
  @@map("supplier")
}

model InventoryItem {
  id              String            @id @default(cuid())
  name            String
  sku             String
  categoryId      String
  unit            UnitType
  unitCost        Decimal           @db.Decimal(10, 2)
  currentStock    Decimal           @default(0) @db.Decimal(12, 3)
  minStock        Decimal           @default(0) @db.Decimal(12, 3)
  maxStock        Decimal           @default(1000) @db.Decimal(12, 3)
  reorderPoint    Decimal           @default(10) @db.Decimal(12, 3)
  branchId        String
  isActive        Boolean           @default(true)
  lastRestockDate DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Relations
  branch        Branch               @relation(fields: [branchId], references: [id])
  category      InventoryCategoryMaster @relation(fields: [categoryId], references: [id])
  inboundStock  InboundStock[]
  outboundStock OutboundStock[]
  wasteLogs          WasteLog[]
  stockCounts        InventoryStockCount[]
  transferLogs       TransferLog[]
  ingredients              MenuItemIngredient[]
  menuItemOptionIngredients MenuItemOptionIngredient[]
  branchWarehouseTransfers BranchWarehouseTransfer[]

  @@unique([sku, branchId])
  @@index([branchId])
  @@index([categoryId])
  @@index([currentStock])
  @@index([sku])
  @@map("inventory_item")
}

model InboundStock {
  id            String   @id @default(cuid())
  branchId      String
  itemId        String
  supplierId    String
  quantity      Decimal  @db.Decimal(12, 3)
  unitCost      Decimal  @db.Decimal(10, 2)
  totalCost     Decimal  @db.Decimal(12, 2)
  invoiceNumber String?
  deliveryDate  DateTime
  receivedBy    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  branch   Branch        @relation(fields: [branchId], references: [id])
  item     InventoryItem @relation(fields: [itemId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])

  @@index([branchId])
  @@index([itemId])
  @@index([deliveryDate])
  @@index([branchId, deliveryDate])
  @@map("inbound_stock")
}

model OutboundStock {
  id           String            @id @default(cuid())
  branchId     String
  itemId       String
  quantity     Decimal           @db.Decimal(12, 3)
  movementType StockMovementType
  reason       String?
  reference    String?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  branch Branch        @relation(fields: [branchId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([branchId])
  @@index([itemId])
  @@index([movementType])
  @@index([createdAt])
  @@map("outbound_stock")
}

model WasteLog {
  id         String   @id @default(cuid())
  branchId   String
  itemId     String
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(10, 2)
  totalCost  Decimal  @db.Decimal(12, 2)
  reason     String
  wasteDate  DateTime
  recordedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  branch Branch        @relation(fields: [branchId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([branchId])
  @@index([itemId])
  @@index([wasteDate])
  @@index([branchId, wasteDate])
  @@map("waste_log")
}

model TransferLog {
  id           String         @id @default(cuid())
  fromBranchId String
  toBranchId   String
  itemId       String
  quantity     Decimal        @db.Decimal(12, 3)
  unitCost     Decimal        @db.Decimal(10, 2)
  totalCost    Decimal        @db.Decimal(12, 2)
  transferDate DateTime
  approvedBy   String?
  receivedBy   String?
  status       TransferStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  fromBranch Branch        @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch        @relation("TransferTo", fields: [toBranchId], references: [id])
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([itemId])
  @@index([transferDate])
  @@index([status])
  @@index([fromBranchId, transferDate])
  @@index([toBranchId, transferDate])
  @@map("transfer_log")
}

// ============================================
// MENU INGREDIENT MAPPING
// ============================================

model MenuItemIngredient {
  id              String   @id @default(cuid())
  menuItemId      String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  unit            UnitType

  // Relations
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([menuItemId])
  @@index([inventoryItemId])
  @@map("menu_item_ingredient")
}

// ============================================
// POS ORDERS
// ============================================

model PosOrder {
  id            String       @id @default(cuid())
  orderNumber   String       @unique
  branchId      String
  cashierId     String?
  status        OrderStatus  @default(NEW)
  type          OrderType
  sourceChannel SalesChannel
  subtotal      Decimal      @db.Decimal(12, 2)
  tax           Decimal      @default(0) @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  paymentMethod String?
  customerName  String?
  notes         String?
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  branch  Branch          @relation(fields: [branchId], references: [id])
  cashier User?           @relation(fields: [cashierId], references: [id])
  items   PosOrderItem[]

  @@index([branchId])
  @@index([cashierId])
  @@index([openedAt])
  @@map("pos_order")
}

model PosOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  notes      String?

  // Relations
  order        PosOrder      @relation(fields: [orderId], references: [id])
  menuItem     MenuItem      @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
  @@map("pos_order_item")
}

// ============================================
// KITCHEN DISPLAY SYSTEM
// ============================================

model KitchenStation {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  description String?
  categories  String? // comma-separated menu categories for routing
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  branch  Branch          @relation(fields: [branchId], references: [id])
  tickets KitchenTicket[]

  @@index([branchId])
  @@map("kitchen_station")
}

model KitchenTicket {
  id          String      @id @default(cuid())
  orderId     String
  stationId   String
  status      OrderStatus @default(NEW)
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime    @updatedAt

  // Relations
  order   Order          @relation(fields: [orderId], references: [id])
  station KitchenStation @relation(fields: [stationId], references: [id])
  items   KitchenItem[]

  @@index([orderId])
  @@index([stationId])
  @@map("kitchen_ticket")
}

model KitchenItem {
  id          String      @id @default(cuid())
  ticketId    String
  orderItemId String
  status      OrderStatus @default(NEW)
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime    @updatedAt

  // Relations
  ticket    KitchenTicket @relation(fields: [ticketId], references: [id])
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_item")
}

// ============================================
// MANUAL POS ENTRY
// ============================================

model ManualEntryBatch {
  id          String   @id @default(cuid())
  branchId    String
  periodStart DateTime
  periodEnd   DateTime
  createdBy   String?
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  branch        Branch            @relation(fields: [branchId], references: [id])
  createdByUser User?             @relation(fields: [createdBy], references: [id])
  lines         ManualEntryLine[]

  @@index([branchId, periodStart, periodEnd])
  @@map("manual_entry_batch")
}

model ManualEntryLine {
  id                   String       @id @default(cuid())
  batchId              String
  date                 DateTime     @db.Date
  channel              SalesChannel
  totalRevenue         Decimal      @db.Decimal(12, 2)
  transactionCount     Int
  menuItemId           String?
  notes                String?
  configurationLabel   String?
  configurationKey     String?

  // Relations
  batch    ManualEntryBatch @relation(fields: [batchId], references: [id])
  menuItem MenuItem?        @relation(fields: [menuItemId], references: [id])

  @@index([batchId])
  @@index([date])
  @@map("manual_entry_line")
}

// ============================================
// API KEYS FOR EXTERNAL ACCESS
// ============================================

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  scopes    String // comma-separated scopes
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  createdBy String?

  // Relations
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("api_key")
}

// ============================================
// TARGETS & ALERTS
// ============================================

model Target {
  id           String   @id @default(cuid())
  branchId     String
  targetType   String
  period       String
  periodStart  DateTime
  periodEnd    DateTime
  targetValue  Decimal  @db.Decimal(14, 2)
  currentValue Decimal  @default(0) @db.Decimal(14, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([targetType])
  @@index([periodStart, periodEnd])
  @@map("target")
}

model Alert {
  id          String        @id @default(cuid())
  branchId    String?
  type        AlertType
  severity    AlertSeverity
  status      AlertStatus   @default(ACTIVE)
  title       String
  message     String
  data        Json?
  triggeredAt DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([triggeredAt])
  @@map("alert")
}

// ============================================
// AI CHAT SYSTEM
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([createdAt])
  @@map("chat_session")
}

model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  role         String // 'user' | 'assistant' | 'system'
  content      String
  provider     String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  cost         Decimal? @db.Decimal(10, 6)
  latencyMs    Int?
  cached       Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_message")
}

model ChatAuditLog {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  query            String
  queryHash        String
  intent           String?
  provider         String
  model            String
  templatesUsed    String[]
  entitiesAccessed String[]
  branchesAccessed String[]
  inputTokens      Int
  outputTokens     Int
  totalCost        Decimal  @db.Decimal(10, 6)
  latencyMs        Int
  cached           Boolean  @default(false)
  blocked          Boolean  @default(false)
  blockReason      String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([provider])
  @@index([blocked])
  @@map("chat_audit_log")
}

model ChatMetric {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  provider     String
  model        String
  totalQueries Int      @default(0)
  totalTokens  Int      @default(0)
  totalCost    Decimal  @default(0) @db.Decimal(12, 4)
  avgLatencyMs Int      @default(0)
  cacheHits    Int      @default(0)
  cacheMisses  Int      @default(0)

  @@unique([date, provider, model])
  @@index([date])
  @@map("chat_metric")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================
// ORGANIZATION & SUBSCRIPTIONS
// ============================================

model Organization {
  id                 String             @id @default(cuid())
  name               String
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  maxBranches        Int                @default(1)
  maxUsers           Int                @default(2)
  maxMenuItems       Int?
  features           Json?
  onlineOrderingEnabled Boolean         @default(false)
  storefrontUrl      String?
  storeSlug          String?            @unique
  storeName          String?
  storeDescription   String?
  storeLogoUrl       String?
  storeBannerUrl     String?
  storeBanners       Json?
  storeTheme         Json?
  businessHours      Json?
  storeTimezone      String?            @default("Africa/Accra")
  storefrontTemplateId String?          @default("classic")
  allowedStorefrontTemplates Json?
  closureMessage     String?
  deliveryEnabled    Boolean            @default(true)
  pickupEnabled      Boolean            @default(true)
  minOrderAmount     Decimal?           @db.Decimal(10, 2)
  deliveryFeeFlat    Decimal?           @db.Decimal(10, 2)
  deliveryRadius     Decimal?           @db.Decimal(5, 2)
  estimatedPrepTime  Int?
  contactEmail       String?
  contactPhone       String?
  whatsappNumber     String?
  facebookUrl        String?
  instagramUrl       String?
  paystackPublicKey  String?
  paystackSecretKey  String?
  paystackEnabled             Boolean            @default(false)
  paystackDashboardEnabled    Boolean            @default(false)
  complimentaryApproverRoles  Json?
  enforceCommissaryRouting    Boolean            @default(false)
  tableManagementEnabled      Boolean            @default(false)
  blockSalesWhenOutOfStock    Boolean            @default(false)
  trialEndsAt                 DateTime?
  subscriptionEndsAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  users               User[]
  branches            Branch[]
  subscription        Subscription?
  warehouses          Warehouse[]
  inventoryCategories InventoryCategoryMaster[]
  staffJobRoles       StaffJobRole[]
  rolePermissions     OrgRolePermission[]

  @@index([tier])
  @@index([status])
  @@map("organization")
}

model OrgRolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           Role
  permission     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permission])
  @@index([organizationId, role])
  @@map("org_role_permission")
}

model InventoryCategoryMaster {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization          Organization             @relation(fields: [organizationId], references: [id])
  inventoryItems        InventoryItem[]
  warehouseInventoryItems WarehouseInventoryItem[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, sortOrder])
  @@map("inventory_category_master")
}

model Subscription {
  id              String             @id @default(cuid())
  organizationId  String             @unique
  tier            SubscriptionTier
  status          SubscriptionStatus
  amount          Decimal            @db.Decimal(10, 2)
  currency        String             @default("GHS")
  billingCycle    String             @default("monthly")
  nextBillingDate DateTime?
  canceledAt      DateTime?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id])
  payments     SubscriptionPayment[]

  @@index([organizationId])
  @@index([status])
  @@map("subscription")
}

model SubscriptionPayment {
  id             String    @id @default(cuid())
  subscriptionId String
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("GHS")
  status         String
  paymentMethod  String?
  reference      String?   @unique
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([reference])
  @@map("subscription_payment")
}

// ============================================
// WAREHOUSE MANAGEMENT
// ============================================

model Warehouse {
  id                 String        @id @default(cuid())
  name               String
  code               String        @unique
  address            String
  city               String
  phone              String?
  email              String?
  organizationId     String
  warehouseType      WarehouseType @default(RAW)
  parentWarehouseId  String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  organization        Organization              @relation(fields: [organizationId], references: [id])
  parentWarehouse     Warehouse?                @relation("WarehouseHierarchy", fields: [parentWarehouseId], references: [id])
  childWarehouses     Warehouse[]               @relation("WarehouseHierarchy")
  inventory           WarehouseInventoryItem[]
  transfersOut        WarehouseBranchTransfer[]
  transfersOutWh      WarehouseTransfer[]       @relation("TransferFromWarehouse")
  transfersInWh       WarehouseTransfer[]       @relation("TransferToWarehouse")
  branchTransfersIn   BranchWarehouseTransfer[]
  wasteLogs           WarehouseWasteLog[]
  outboundLogs        WarehouseOutboundLog[]
  inboundRecords      WarehouseInbound[]
  productionRecipes   ProductionRecipe[]
  productionBatches   ProductionBatch[]
  assignedUsers       User[]                    @relation("UserAssignedWarehouse")

  @@index([organizationId])
  @@index([warehouseType])
  @@index([parentWarehouseId])
  @@index([code])
  @@map("warehouse")
}

model WarehouseInventoryItem {
  id           String            @id @default(cuid())
  warehouseId  String
  name         String
  sku          String
  categoryId   String
  unit         UnitType
  unitCost     Decimal           @db.Decimal(10, 2)
  currentStock Decimal           @default(0) @db.Decimal(12, 3)
  minStock     Decimal           @default(0) @db.Decimal(12, 3)
  reorderPoint Decimal           @default(10) @db.Decimal(12, 3)
  maxStock     Decimal?          @db.Decimal(12, 3)
  itemStage                    InventoryItemStage @default(RAW)
  requiresCommissaryProcessing Boolean            @default(false)
  allowDirectToBranch          Boolean            @default(true)
  isActive                     Boolean            @default(true)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  // Relations
  warehouse              Warehouse                   @relation(fields: [warehouseId], references: [id])
  category               InventoryCategoryMaster     @relation(fields: [categoryId], references: [id])
  transfers              WarehouseBranchTransfer[]
  warehouseTransfers     WarehouseTransfer[]
  wasteLogs              WarehouseWasteLog[]
  outboundLogs           WarehouseOutboundLog[]
  inboundRecords         WarehouseInbound[]
  productionOutputs      ProductionRecipe[]          @relation("ProductionOutputItem")
  productionIngredients  ProductionRecipeLine[]
  productionConsumptions ProductionBatchConsumption[]

  @@unique([sku, warehouseId])
  @@index([warehouseId])
  @@index([categoryId])
  @@map("warehouse_inventory_item")
}

model WarehouseBranchTransfer {
  id                   String         @id @default(cuid())
  warehouseId          String
  warehouseItemId      String
  toBranchId           String
  quantity             Decimal        @db.Decimal(12, 3)
  unitCost             Decimal        @db.Decimal(10, 2)
  totalCost            Decimal        @db.Decimal(12, 2)
  status               TransferStatus @default(PENDING)
  transferDate         DateTime
  requestedBy          String?
  warehouseApprovedBy  String?
  warehouseApprovedAt  DateTime?
  approvedBy           String?
  receivedBy           String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relations
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseItem WarehouseInventoryItem @relation(fields: [warehouseItemId], references: [id])
  toBranch      Branch                 @relation("WarehouseTransfers", fields: [toBranchId], references: [id])

  @@index([warehouseId])
  @@index([toBranchId])
  @@index([status])
  @@index([transferDate])
  @@map("warehouse_branch_transfer")
}

model WarehouseTransfer {
  id              String                @id @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  warehouseItemId String
  transferKind    WarehouseTransferKind @default(MATERIAL_ISSUE)
  quantity        Decimal               @db.Decimal(12, 3)
  unitCost        Decimal               @db.Decimal(10, 2)
  totalCost       Decimal               @db.Decimal(12, 2)
  status          TransferStatus        @default(PENDING)
  transferDate    DateTime
  approvedBy      String?
  receivedBy      String?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  fromWarehouse Warehouse              @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse              @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  warehouseItem WarehouseInventoryItem @relation(fields: [warehouseItemId], references: [id])

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([transferDate])
  @@map("warehouse_transfer")
}

model BranchWarehouseTransfer {
  id            String         @id @default(cuid())
  fromBranchId  String
  toWarehouseId String
  branchItemId  String
  quantity      Decimal        @db.Decimal(12, 3)
  unitCost      Decimal        @db.Decimal(10, 2)
  totalCost     Decimal        @db.Decimal(12, 2)
  status        TransferStatus @default(PENDING)
  transferDate  DateTime
  approvedBy    String?
  receivedBy    String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  fromBranch  Branch        @relation("BranchWarehouseReturns", fields: [fromBranchId], references: [id])
  toWarehouse Warehouse     @relation(fields: [toWarehouseId], references: [id])
  branchItem  InventoryItem @relation(fields: [branchItemId], references: [id])

  @@index([fromBranchId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("branch_warehouse_transfer")
}

model ProductionRecipe {
  id              String   @id @default(cuid())
  warehouseId     String
  name            String
  outputItemId    String
  outputQuantity  Decimal  @default(1) @db.Decimal(12, 3)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse  Warehouse                @relation(fields: [warehouseId], references: [id])
  outputItem WarehouseInventoryItem   @relation("ProductionOutputItem", fields: [outputItemId], references: [id])
  lines      ProductionRecipeLine[]
  batches    ProductionBatch[]

  @@index([warehouseId])
  @@map("production_recipe")
}

model ProductionRecipeLine {
  id              String  @id @default(cuid())
  recipeId        String
  ingredientItemId String
  quantity        Decimal @db.Decimal(12, 3)

  recipe           ProductionRecipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientItem   WarehouseInventoryItem @relation(fields: [ingredientItemId], references: [id])

  @@index([recipeId])
  @@map("production_recipe_line")
}

model ProductionBatch {
  id              String                @id @default(cuid())
  recipeId        String
  warehouseId     String
  status          ProductionBatchStatus @default(DRAFT)
  plannedOutput   Decimal               @db.Decimal(12, 3)
  actualOutput    Decimal?              @db.Decimal(12, 3)
  wasteQuantity   Decimal               @default(0) @db.Decimal(12, 3)
  producedBy      String?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipe        ProductionRecipe             @relation(fields: [recipeId], references: [id])
  warehouse     Warehouse                    @relation(fields: [warehouseId], references: [id])
  consumptions  ProductionBatchConsumption[]

  @@index([warehouseId])
  @@index([recipeId])
  @@index([status])
  @@map("production_batch")
}

model ProductionBatchConsumption {
  id              String  @id @default(cuid())
  batchId         String
  ingredientItemId String
  quantity        Decimal @db.Decimal(12, 3)

  batch            ProductionBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  ingredientItem   WarehouseInventoryItem @relation(fields: [ingredientItemId], references: [id])

  @@index([batchId])
  @@map("production_batch_consumption")
}

model WarehouseWasteLog {
  id              String   @id @default(cuid())
  warehouseId     String
  warehouseItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  reason          String
  notes           String?
  recordedBy      String?
  wasteDate       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseItem WarehouseInventoryItem @relation(fields: [warehouseItemId], references: [id])

  @@index([warehouseId])
  @@index([warehouseItemId])
  @@index([wasteDate])
  @@map("warehouse_waste_log")
}

model WarehouseOutboundLog {
  id              String   @id @default(cuid())
  warehouseId     String
  warehouseItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  reason          String
  notes           String?
  recordedBy      String?
  outboundDate    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseItem WarehouseInventoryItem @relation(fields: [warehouseItemId], references: [id])

  @@index([warehouseId])
  @@index([warehouseItemId])
  @@index([outboundDate])
  @@map("warehouse_outbound_log")
}

model WarehouseInbound {
  id              String   @id @default(cuid())
  warehouseId     String
  warehouseItemId String
  supplierId      String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(10, 2)
  totalCost       Decimal  @db.Decimal(12, 2)
  invoiceNumber   String?
  notes           String?
  receivedBy      String?
  deliveryDate    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  warehouseItem WarehouseInventoryItem @relation(fields: [warehouseItemId], references: [id])
  supplier      Supplier               @relation(fields: [supplierId], references: [id])

  @@index([warehouseId])
  @@index([warehouseItemId])
  @@index([supplierId])
  @@index([deliveryDate])
  @@map("warehouse_inbound")
}

// ============================================
// CUSTOMER RELATIONSHIP MANAGEMENT
// ============================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  city      String?
  location  String?
  customerVibe CustomerVibe?
  specialNotes String?
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders           Order[]
  whatsappSessions WhatsAppSession[]

  @@index([phone])
  @@map("customer")
}

// ============================================
// UNIFIED ORDER MANAGEMENT
// ============================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  branchId        String
  assignedBy      String?
  cashierId       String?
  customerName    String?
  source          OrderSource
  type            OrderType
  status          OrderStatus   @default(NEW)
  subtotal        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(12, 2)
  paymentMethod   String?
  paymentStatus   PaymentStatus @default(PENDING)
  notes           String?
  deliveryAddress String?
  deliveryCity    String?
  deliveryNeighborhood String?
  deliveryLat     Decimal?      @db.Decimal(10, 8)
  deliveryLng     Decimal?      @db.Decimal(11, 8)
  deliveryPhone   String?
  deliveryNotes   String?
  openedAt        DateTime      @default(now())
  orderReceivedTime DateTime?
  closedAt        DateTime?
  isComplimentary Boolean       @default(false)
  complimentaryAuthorizedBy String?
  complimentaryReason       String?
  complimentaryAuthorizedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  offlineClientMutationId String? @unique
  tableSessionId          String?

  // Relations
  customer       Customer?           @relation(fields: [customerId], references: [id])
  branch         Branch              @relation(fields: [branchId], references: [id])
  assignedByUser User?               @relation("AssignedOrders", fields: [assignedBy], references: [id])
  cashier        User?               @relation("CashierOrders", fields: [cashierId], references: [id])
  tableSession   TableSession?       @relation(fields: [tableSessionId], references: [id])
  items          OrderItem[]
  tickets        KitchenTicket[]
  delivery       DeliveryRequest?
  notifications  OrderNotification[]
  payments       Payment[]
  receipt        Receipt?

  @@index([customerId])
  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([source])
  @@index([orderNumber])
  @@index([tableSessionId])
  @@map("order")
}

model DiningSection {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables DiningTable[]

  @@index([branchId])
  @@map("dining_section")
}

model DiningTable {
  id        String            @id @default(cuid())
  branchId  String
  sectionId String?
  label     String
  capacity  Int               @default(4)
  sortOrder Int               @default(0)
  status    DiningTableStatus @default(AVAILABLE)
  posX      Int?
  posY      Int?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section  DiningSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sessions TableSession[]

  @@unique([branchId, label])
  @@index([branchId])
  @@index([sectionId])
  @@index([status])
  @@map("dining_table")
}

model TableSession {
  id              String             @id @default(cuid())
  branchId        String
  tableId         String
  openedByUserId  String
  guestCount      Int                @default(1)
  status          TableSessionStatus @default(OPEN)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table    DiningTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  opener   User         @relation("TableSessionsOpened", fields: [openedByUserId], references: [id])
  orders   Order[]

  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([openedByUserId])
  @@map("table_session")
}

model PosOfflineMutation {
  id               String                   @id @default(cuid())
  clientMutationId String                   @unique
  orderId          String?
  status           PosOfflineMutationStatus @default(PENDING)
  payloadJson      Json
  resultJson       Json?
  errorMessage     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status])
  @@map("pos_offline_mutation")
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  menuItemId           String
  quantity             Int
  unitPrice            Decimal @db.Decimal(10, 2)
  lineTotal            Decimal @db.Decimal(12, 2)
  notes                String?
  configurationLabel   String?
  configurationKey     String?

  // Relations
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem               @relation(fields: [menuItemId], references: [id])
  kitchenItems KitchenItem[]
  selections   OrderItemSelection[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([configurationKey])
  @@map("order_item")
}

model OrderItemSelection {
  id               String @id @default(cuid())
  orderItemId      String
  menuItemOptionId String

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItemOption MenuItemOption @relation(fields: [menuItemOptionId], references: [id])

  @@unique([orderItemId, menuItemOptionId])
  @@index([orderItemId])
  @@index([menuItemOptionId])
  @@map("order_item_selection")
}

// ============================================
// DELIVERY INTEGRATION
// ============================================

model DeliveryRequest {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  provider           String?
  externalId         String?
  pickupAddress      String?
  pickupLat          Decimal?       @db.Decimal(10, 8)
  pickupLng          Decimal?       @db.Decimal(11, 8)
  deliveryAddress    String?
  neighborhood       String?
  deliveryLat        Decimal?       @db.Decimal(10, 8)
  deliveryLng        Decimal?       @db.Decimal(11, 8)
  deliveryPhone      String?
  customerName       String?
  status             DeliveryStatus @default(PENDING)
  driverName         String?
  driverPhone        String?
  estimatedTime      Int?
  dispatchTime       DateTime?
  actualPickupTime   DateTime?
  actualDeliveryTime DateTime?
  deliveryIssues     DeliveryIssue[] @default([])
  comments           String?
  fee                Decimal        @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("delivery_request")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  reference   String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("GHS")
  status      PaymentStatus @default(PENDING)
  provider       String        @default("paystack")
  paymentMethod  String?
  providerRef    String?
  paidAt         DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([reference])
  @@map("payment")
}

// ============================================
// WHATSAPP ORDERING
// ============================================

model WhatsAppSession {
  id            String   @id @default(cuid())
  phoneNumber   String   @unique
  customerId    String?
  state         String   @default("IDLE")
  cartData      Json?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customer Customer?         @relation(fields: [customerId], references: [id])
  messages WhatsAppMessage[]

  @@index([phoneNumber])
  @@map("whatsapp_session")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  sessionId   String
  direction   String
  content     String
  messageType String
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  session WhatsAppSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("whatsapp_message")
}

// ============================================
// NOTIFICATIONS & RECEIPTS
// ============================================

model OrderNotification {
  id        String           @id @default(cuid())
  orderId   String
  type      NotificationType
  channel   String
  recipient String
  subject   String?
  message   String
  status    String           @default("PENDING")
  sentAt    DateTime?
  error     String?
  createdAt DateTime         @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([type])
  @@map("order_notification")
}

model Receipt {
  id            String   @id @default(cuid())
  orderId       String   @unique
  receiptNumber String   @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  items         Json
  subtotal      Decimal  @db.Decimal(12, 2)
  tax           Decimal  @db.Decimal(12, 2)
  discount      Decimal  @db.Decimal(12, 2)
  deliveryFee   Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(12, 2)
  paymentMethod String
  pdfUrl        String?
  sentVia       String[]
  createdAt     DateTime @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("receipt")
}
