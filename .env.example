# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dinelytix?schema=public"

# BetterAuth
BETTER_AUTH_SECRET="your-super-secret-key-min-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@dinelytix.com"

# AI Providers
OPENAI_API_KEY="sk-your-openai-api-key"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# AI Chat Configuration
CHAT_ENABLED="true"
CHAT_DEFAULT_PROVIDER="auto"
CHAT_MAX_TOKENS_PER_REQUEST="4000"
